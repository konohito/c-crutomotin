# functions/.env — ローカルエミュレータ用の設定例。実際の値を入れて functions/.env として保存する。
# 本番(デプロイ)では `firebase functions:secrets` か環境変数で設定する。

# --- 文字の読み取りをどちらで行うか（切り替えはここだけ） ---
# docai  … Document AI（文字と座標）＋ Gemini を補助に使う。従来どおり。
#           ★Document AI には日本リージョンが無いため、**読み取りの瞬間だけ米国へ出る**。
# gemini … Gemini（Vertex AI・東京）だけで読む。**国外へ出る経路が無くなる**。
#           ★座標を使う検算（四隅マーカー・はい/いいえ列の照合）が無いので、
#             読めた項目は全件そのまま職員の確認に回る（自動判定にはならない）。
# 未設定なら既定の docai。知らない値を入れても使われず、既定へ倒してログに残る。
OCR_ENGINE=docai

# --- Document AI（OCR_ENGINE=docai のときだけ使う） ---
# GCP プロジェクト ID(Cloud Functions 上では自動設定されるためローカルのみ必要)
DOCAI_PROJECT_ID=your-gcp-project-id
# Document AI プロセッサのロケーション: us / eu など
DOCAI_LOCATION=us
# 作成した Form Parser もしくはカスタム抽出プロセッサの ID
DOCAI_PROCESSOR_ID=xxxxxxxxxxxxxxxx

# --- 任意 ---
# 簡易 API キー(設定するとフロントの VITE_OCR_API_KEY と一致必須になる)
OCR_API_KEY=
# CORS 許可オリジン(本番は SPA の URL を指定。例: https://konohito.github.io)
OCR_ALLOW_ORIGIN=*
# 画像サイズ上限(バイト)
OCR_MAX_BYTES=10485760
# 要確認しきい値(%)。フロントの CONF_THRESHOLD と揃える
OCR_REVIEW_THRESHOLD=80

# ビジョン AI 読み取り(Vertex AI / Gemini)。0 で無効化
VISION_READ=1
# 使うモデル。**空のままでよい**(空なら既定の gemini-3.5-flash で動く)。
# ここに書いてよいのは、東京(asia-northeast1)で呼べて、かつ公式のデータレジデンシー表で
# 機械学習の処理が日本国内に限定されると書かれているモデルだけ。いまは gemini-3.5-flash の 1 つ。
#   書いてよい: gemini-3.5-flash
#   書いてはいけない例: 2.5 系(2.5-flash / 2.5-pro)は 2026-10-16 に提供終了済み。
#                      3-flash / 3-pro / 3.5-pro は東京に無い(2026-09-26 実測 404)。
# 許可した名前以外を入れても使われない。functions/src/ai-model.js が弾いて既定へ倒し、
# 「設定を直してください」とログに残す(= 黙って別のモデルへ流れることはない)。
GEMINI_MODEL=gemini-3.5-flash
