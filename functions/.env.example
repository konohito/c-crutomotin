# functions/.env — ローカルエミュレータ用の設定例。実際の値を入れて functions/.env として保存する。
# 本番(デプロイ)では `firebase functions:secrets` か環境変数で設定する。

# --- 読み取りエンジン ---
# vision = Vertex AI(Gemini・東京リージョン)だけで読む。既定。画像が国外へ出ない
# docai  = 従来の Document AI 経路。Document AI に東京リージョンは無く画像が国外へ出る
#          (委託元には国内限定と回答済み。docs/kashima/ を参照)
OCR_ENGINE=vision

# --- Document AI (OCR_ENGINE=docai のときだけ使う) ---
# GCP プロジェクト ID(Cloud Functions 上では自動設定されるためローカルのみ必要)
DOCAI_PROJECT_ID=your-gcp-project-id
# Document AI プロセッサのロケーション: us / eu など(東京は提供されていない)
DOCAI_LOCATION=us
# 作成した Form Parser もしくはカスタム抽出プロセッサの ID
DOCAI_PROCESSOR_ID=xxxxxxxxxxxxxxxx

# --- 任意 ---
# 簡易 API キー(設定するとフロントの VITE_OCR_API_KEY と一致必須になる)
OCR_API_KEY=
# CORS 許可オリジン(本番は SPA の URL を指定。例: https://konohito.github.io)
OCR_ALLOW_ORIGIN=*
# 画像サイズ上限(バイト)
OCR_MAX_BYTES=10485760
# 要確認しきい値(%)。フロントの CONF_THRESHOLD と揃える
OCR_REVIEW_THRESHOLD=80

# ビジョン AI 読み取り(Vertex AI / Gemini)。0 で無効化。モデルは必要に応じて差し替え可
VISION_READ=1
# 先頭に試すモデル。空にすると候補の最上位(最高性能)から順に試す ← 推奨
GEMINI_MODEL=
# 実 Vertex AI を呼ばず合成結果で通す(エミュレータでは既定で有効。0 で無効化)
VISION_MOCK=
# Vertex AI の呼び出しリージョン。既定は東京(asia-northeast1)。
# 記録用紙の写真には氏名・測定値が写るため、処理を日本国内に閉じている
# (嘉島町への回答 docs/kashima/ を参照)。変更は影響を確認のうえ行うこと。
VERTEX_LOCATION=asia-northeast1
