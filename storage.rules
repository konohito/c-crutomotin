rules_version = '2';
// Cloud Storage セキュリティルール。
// 記録用紙の画像には利用者の氏名・参加者ID・測定値が写っている。
//
// ★2026-10-22 修正（嘉島町役場からのセキュリティ照会を機に点検して見つけた穴）
//   それまでは read / create / update / delete すべてが `request.auth != null` だけだった。
//   つまり「ログインできれば誰でも読める・消せる」状態で、具体的には
//     ・電子手帳の利用者アカウント（portalUsers・u+ID@techo.cruto-motion.app）
//     ・第三者が自分で作ったアカウント（Firebase Auth の self-signup が開いている）
//   からも、氏名が写った用紙の画像を読めて、しかも削除までできた。
//   firestore.rules は同じ事情を踏まえて `isStaff()`（管理者が staff/{uid} を作った職員だけ）を
//   要求しているのに、Storage だけが要求していない**非対称**になっていた。
//
//   ここを firestore.rules と同じ条件にそろえる。
//   Storage のルールから Firestore を参照できる（クロスサービスルール）ので、
//   firestore.rules の isStaff() と**同じ文書**（staff/{uid}）を見る。
//   ★片方だけ直さないこと。職員の承認の仕組みを変えるときは両方を直す。
service firebase.storage {
  match /b/{bucket}/o {

    // 承認済み職員か。firestore.rules の isStaff() と同じ判定。
    // ログインしているだけでは通らない（管理者が staff/{uid} を作った職員だけ）。
    //
    // ★★2026-10-26 ここで4日間、写真アップロードが全部止まった（必ず読むこと）
    //   firestore.exists(...) は「Storage のルールから Firestore を見る」書き方
    //   （クロスサービス）で、**Google 側で権限を1つ付けないと参照そのものが失敗する**。
    //   失敗すると条件が false になり、承認済みの職員でも**全部断られる**。
    //   実測: 10/21 まで毎日20件前後上がっていた用紙の画像が、10/22 の配信以降 0件。
    //   必要な権限（1回付ければよい。付いていることを確かめてから配信する）:
    //     roles/firebaserules.firestoreServiceAgent
    //     → serviceAccount:service-<プロジェクト番号>@gcp-sa-firebasestorage.iam.gserviceaccount.com
    //   Firebase の画面でルールを書くと付けるよう促されるが、
    //   **コマンドラインや CI から配信すると何も言われずに壊れる**。
    //   ★配信したら必ず、職員のアカウントで**実際に1枚上げて**確かめること。
    //     ルールの文面を読むだけでは止められない（今回それで見落とした）。
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    match /sheets/{batchId}/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      // 本登録/却下の済んだ画像はストレージ費用を抑えるため職員が削除できる
      allow delete: if isStaff();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
