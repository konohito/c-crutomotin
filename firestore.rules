rules_version = '2';
// Firestore セキュリティルール — 承認された職員のみ読み書き可。
// Firebase の apiKey は公開情報のため「ログインしていれば読める」では不十分
// （誰でも self-signup できてしまう）。管理者が staff/{uid} を作成した職員だけに限定する。
service cloud.firestore {
  match /databases/{database}/documents {

    // 承認済み職員か（管理者が staff/{uid} を作成。self-signup では staff 文書が無く読めない）
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // 電子手帳の利用者本人か（職員が portalUsers/{authUid} を発行した利用者のみ。
    // self-signup では portalUsers 文書が無いため何も読めない）
    function isPortalOwner(userId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.userId == userId;
    }

    // 職員許可リスト。承認済み職員はアプリの「職員管理」で一覧・追加・解除できる（全員同権限）。
    // 最初の 1 人だけは CLI(grant-staff.mjs / Admin SDK)で承認する（ルールをすり抜ける）。
    match /staff/{uid} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isStaff();
    }

    // 読み取りキュー(OCR 結果)。作成はバックエンド(Admin SDK)が行うためルールをすり抜ける。
    // クライアントは閲覧と、確認・本登録に伴うステータス更新のみ許可する。
    match /batches/{batchId} {
      allow read: if isStaff();
      /* 職員が触れるのは 2 つだけ。
         finishedAt: 全件処理済みマーク(取り込み画面のプルダウンから除くため)
         uploadCount: 送信した枚数(読み取り件数と突き合わせて取りこぼしを検知するため。
                      アップロード時点で加算するので、バックエンドの処理より先に作られ得る) */
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finishedAt', 'uploadCount']);
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['uploadCount']);
      allow delete: if false; // それ以外のメタ更新はバックエンドのみ

      match /recognitions/{recognitionId} {
        allow read: if isStaff();
        // 職員による確認・本登録の反映のみ許可(status / 解決値 / 照合ユーザ)。新規作成・削除は不可。
        allow update: if isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolvedValues', 'matchedUserId', 'reviewedBy', 'reviewedAt']);
        allow create, delete: if false;
      }
    }

    // 未処理件数バッジ用のコレクショングループクエリ(全バッチ横断で recognitions を数える)
    match /{path=**}/recognitions/{recognitionId} {
      allow read: if isStaff();
    }

    // 飛び込み読み込みキュー(様式 R7-02W)。作成はバックエンドのみ。
    // 職員は閲覧と、仮登録・台帳登録に伴うステータス更新のみ許可する。
    match /walkins/{walkinId} {
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['walkinStatus', 'userId', 'userName', 'registeredAt', 'reviewedBy']);
      allow create: if false;
      allow delete: if isStaff(); // 誤スキャン・重複エントリの削除
    }

    // 利用者台帳。承認職員が閲覧・編集可（氏名・市町村/行政区・介護度・電話 等）。削除は不可。
    // 電子手帳の利用者本人は自分の文書のみ閲覧可。
    match /users/{userId} {
      allow read: if isStaff() || isPortalOwner(userId);
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // 測定データ。承認職員が閲覧・作成・編集可（実データ取り込み後の修正を含む）。削除は不可(監査性)。
    // 電子手帳の利用者本人は自分の測定のみ閲覧可（where userId == 本人ID のクエリ）。
    match /measurements/{measurementId} {
      allow read: if isStaff()
        || (request.auth != null && isPortalOwner(resource.data.userId));
      allow create, update: if isStaff()
        && request.resource.data.keys().hasAll(['userId', 'year']);
      allow delete: if false;
    }

    // 電子手帳の利用者アカウント紐付け（authUid → 参加者ID）。発行・解除は職員のみ。
    match /portalUsers/{uid} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isStaff();
    }

    // 電子手帳（目標・興味関心 + 体調/活動記録）。職員と本人が読み書きできる。
    match /techo/{userId} {
      allow read, create, update: if isStaff() || isPortalOwner(userId);
      allow delete: if false;

      match /logs/{logId} {
        allow read, create: if isStaff() || isPortalOwner(userId);
        allow update: if false;       // 記録は追記式（訂正は削除して入れ直す）
        allow delete: if isStaff();   // 誤入力の訂正は職員のみ
      }
    }
  }
}
